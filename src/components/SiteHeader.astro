---
import { vendorDirectoryEnabled } from "../config/features";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const onPartners = currentPath.startsWith("/partners");
const onPartnerLanding = currentPath === "/partners" || currentPath === "/partners/";
const onVendors = currentPath.startsWith("/vendors");
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand brand-artwork" href="/" aria-label="Space City Halloween Festival home">
      <span class="brand-logo-crop">
        <img
          src="/space-city-collective-logo.jpg"
          alt="Space City Collective"
          width="438"
          height="438"
        />
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="/#event" aria-current={!onPartners && !onVendors ? "page" : undefined}>Event guide</a>
      {vendorDirectoryEnabled && <a href="/vendors/" aria-current={onVendors ? "page" : undefined}>Vendors</a>}
      <a href="/partners/" aria-current={onPartners ? "page" : undefined}>For businesses</a>
      <a href="/#faq">FAQ</a>
    </nav>

    <details class="mobile-nav">
      <summary>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>Menu</span>
      </summary>
      <nav aria-label="Mobile navigation">
        <a href="/#event" aria-current={!onPartners && !onVendors ? "page" : undefined}>Event guide</a>
        {vendorDirectoryEnabled && <a href="/vendors/" aria-current={onVendors ? "page" : undefined}>Vendors</a>}
        <a href="/partners/" aria-current={onPartners ? "page" : undefined}>For businesses</a>
        <a href="/#faq">FAQ</a>
      </nav>
    </details>

    <a
      class="button button-small header-cta"
      href={onPartnerLanding ? "#inquiry" : "/partners/#inquiry"}
      data-track-event={onPartnerLanding ? "inquiry_cta_clicked" : "partner_cta_clicked"}
      data-track-placement="site_header"
    >
      {onPartnerLanding ? "Send an inquiry" : "Partner with us"}
    </a>
  </div>
</header>
