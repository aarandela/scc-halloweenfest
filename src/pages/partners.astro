---
import Icon from "../components/Icon.astro";
import InquiryForm from "../components/InquiryForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { event, sponsorBenefits, sponsorTiers } from "../data/event";

const description = `Sponsor or vend at the ${event.name}. Compare sponsorship opportunities and send an interest form to the Space City Collective team.`;

function priceLabel(price: number) {
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0
  }).format(price);
}
---

<BaseLayout title={`Business Opportunities | ${event.name}`} {description} canonicalPath="/partners/">
  <main id="main-content">
    <section class="partner-hero" aria-labelledby="partner-title">
      <div class="container partner-hero-content">
        <div>
          <p class="eyebrow">Sponsor · vend · make an impact</p>
          <h1 id="partner-title">Sponsor the festival.</h1>
          <p class="hero-lede">Reach more than 4,000 Pearland-area attendees and help keep the festival free for families.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#packages" data-track-event="packages_viewed" data-track-placement="partner_hero">Compare packages <Icon name="arrow" size={17} /></a>
            <a class="button button-secondary" href="#inquiry" data-track-event="inquiry_cta_clicked" data-track-placement="partner_hero">Send an inquiry</a>
          </div>
        </div>
        <aside class="hero-side-note">
          <strong>4,000+</strong>
          <span>people attended last year. Your support helps the festival welcome even more of Pearland.</span>
        </aside>
      </div>
    </section>

    <section class="section" aria-labelledby="why-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">What your support does</p>
            <h2 id="why-title">Visible before, during, and after the event.</h2>
          </div>
          <p>Choose a package based on how much on-site presence and promotion your business needs.</p>
        </div>
        <div class="sponsor-ledger">
          <article><span>01</span><h3>Be seen</h3><p>Your logo appears across event materials, the website, social posts, and event-day signage.</p></article>
          <article><span>02</span><h3>Meet Pearland</h3><p>Higher tiers put your business on site where thousands of families are spending the afternoon.</p></article>
          <article><span>03</span><h3>Fund a free event</h3><p>Your support helps pay for a safe public festival, trick-or-treating, and activities for kids.</p></article>
        </div>
      </div>
    </section>

    <section class="section tiers-section" id="packages" aria-labelledby="packages-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Sponsorship packages</p>
            <h2 id="packages-title">Three ways to sponsor.</h2>
          </div>
          <p>Every level includes core event visibility. Higher tiers add on-site access, premium recognition, and custom promotion.</p>
        </div>

        <div class="tier-cards package-slips">
          {sponsorTiers.map((tier, index) => (
            <article class:list={["tier-card", { featured: index === 2 }]}>
              <span class="tier-number">Level 0{index + 1}</span>
              <h3>{tier.name}</h3>
              <div class="tier-price">{priceLabel(tier.price)}</div>
              <p>{tier.description}</p>
            </article>
          ))}
        </div>

        <div class="comparison-wrap" tabindex="0" role="region" aria-label="Scrollable sponsorship benefits comparison">
          <table class="comparison-table">
            <caption class="sr-only">Benefits included in each Space City Halloween Festival sponsorship level</caption>
            <thead>
              <tr>
                <th scope="col">Benefit</th>
                {sponsorTiers.map((tier) => <th scope="col">{tier.name}</th>)}
              </tr>
            </thead>
            <tbody>
              {sponsorBenefits.map((benefit) => (
                <tr>
                  <td>{benefit.label}</td>
                  {benefit.tiers.map((value) => (
                    <td>
                      {value === false ? <span class="dash" aria-label="Not included">—</span> : value === "Included" ? <span class="check" aria-label="Included">✓</span> : <span class="benefit-detail">{value}</span>}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="table-note">Benefits shown are based on the published 2026 sponsorship flyer. The festival team will confirm availability and final details.</p>
      </div>
    </section>

    <section class="section vendor-section" aria-labelledby="vendor-title">
      <div class="container vendor-grid">
        <div>
          <p class="eyebrow">Vendor opportunities</p>
          <h2 class="display-heading" id="vendor-title">Want to vend? Tell us what you sell.</h2>
          <p>Retail, food, art, handmade goods, services, nonprofits, and other community businesses can apply. Vendor pricing and requirements have not been published yet; the event coordinator will follow up with availability and next steps.</p>
          <a class="button button-primary" href="/partners/?interest=vendor#inquiry" data-track-event="inquiry_cta_clicked" data-track-placement="vendor_section" data-track-inquiry-type="vendor">Ask about vending <Icon name="arrow" size={17} /></a>
        </div>
        <div class="vendor-type" aria-hidden="true">
          <span>Vend</span><span>Shop</span><span>Eat</span><span>Meet</span>
        </div>
      </div>
    </section>

    <section class="section form-section" id="inquiry" aria-labelledby="inquiry-title">
      <div class="container">
        <InquiryForm />
      </div>
    </section>
  </main>
</BaseLayout>
