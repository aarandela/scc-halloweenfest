---
import Icon from "../components/Icon.astro";
import SponsorWall from "../components/SponsorWall.astro";
import VendorListing from "../components/VendorListing.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { vendorDirectoryEnabled } from "../config/features";
import { activities, event } from "../data/event";
import { eventPhotos } from "../data/eventPhotos";
import { vendors } from "../data/vendors";

const description = `${event.dateDisplay} at ${event.venue}. A free community event with trick-or-treating, a costume contest, music, games, vendors, activities, and food.`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Festival",
  name: event.name,
  description: event.description,
  startDate: "2026-10-24T14:00:00-05:00",
  endDate: "2026-10-24T20:00:00-05:00",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  isAccessibleForFree: true,
  location: {
    "@type": "Place",
    name: event.venue,
    address: {
      "@type": "PostalAddress",
      streetAddress: "11200 Broadway St",
      addressLocality: "Pearland",
      addressRegion: "TX",
      postalCode: "77584",
      addressCountry: "US"
    }
  },
  organizer: {
    "@type": "Organization",
    name: event.organizer,
    email: event.contactEmail
  },
  offers: {
    "@type": "Offer",
    price: 0,
    priceCurrency: "USD",
    availability: "https://schema.org/InStock"
  }
};

---

<BaseLayout title={`${event.name} | ${event.dateDisplay}`} {description} structuredData={structuredData}>
  <main id="main-content">
    <section class="hero poster-hero" aria-labelledby="event-title">
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Presented by Space City Collective · Free admission · Pearland, Texas</p>
          <h1 id="event-title">Halloween <span>Festival</span></h1>
          <p class="hero-lede">A free Saturday in Pearland with costumes, candy, music, games, food, activities, local vendors, and community.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#event" data-track-event="visit_cta_clicked" data-track-placement="home_hero">Plan your visit <Icon name="arrow" size={17} /></a>
            <a class="button button-secondary" href="/partners/" data-track-event="partner_cta_clicked" data-track-placement="home_hero">Partner with us</a>
          </div>
        </div>
        <div class="event-bill" aria-label={`${event.dateDisplay}, ${event.timeDisplay}, ${event.venue}`}>
          <div class="bill-topline"><span>Space City Collective presents</span><span>Free entry</span></div>
          <div class="bill-date"><strong>24</strong><span>Oct<br />2026</span></div>
          <div class="bill-rule"></div>
          <p>{event.timeDisplay}</p>
          <h2>Pearland<br />Town Center</h2>
          <div class="bill-footer"><span>Methodist Pavilion</span><span>All ages</span></div>
        </div>
      </div>
    </section>

    <div class="fact-strip" id="event">
      <div class="container fact-grid">
        <div class="fact">
          <Icon name="calendar" />
          <div>
            <span>When</span>
            <strong>{event.dateDisplay}</strong>
            <div class="fact-calendar-links">
              <a href={event.calendarDownloadUrl} download data-track-event="calendar_added" data-track-method="ics">Add to calendar</a>
              <a href={event.googleCalendarUrl} target="_blank" rel="noreferrer" data-track-event="calendar_added" data-track-method="google">Google Calendar</a>
            </div>
          </div>
        </div>
        <div class="fact"><Icon name="clock" /><div><span>Time</span><strong>{event.timeDisplay}</strong></div></div>
        <div class="fact"><Icon name="pin" /><div><span>Where</span><strong>{event.venue}</strong></div></div>
        <div class="fact"><Icon name="ticket" /><div><span>Admission</span><strong>{event.admission}</strong></div></div>
      </div>
    </div>

    <section class="section" aria-labelledby="happening-title">
      <div class="container">
        <div class="section-heading program-heading">
          <div>
            <p class="eyebrow">What’s happening</p>
            <h2 id="happening-title">One afternoon.<br />A whole lot of fun.</h2>
          </div>
          <p>Bring the whole crew for a family-friendly celebration of Halloween, local flavor, creative businesses, and community.</p>
        </div>
        <div class="program-list">
          {activities.map((activity, index) => (
            <article class="program-item">
              <span class="program-number">0{index + 1}</span>
              <h3>{activity.title}</h3>
              <p>{activity.description}</p>
              <time>{activity.time}</time>
            </article>
          ))}
        </div>
      </div>
    </section>

    {vendorDirectoryEnabled && <section class="section vendor-preview" aria-labelledby="vendor-preview-title">
      <div class="container">
        <div class="vendor-preview-heading">
          <div>
            <p class="eyebrow">Vendor lineup</p>
            <h2 class="display-heading" id="vendor-preview-title">Who’ll be there.</h2>
          </div>
          <div>
            <p class="sample-notice">Sample lineup for demonstration</p>
            <p>Give attendees a reason to arrive early by showing them who they can shop, meet, and eat with at the festival.</p>
          </div>
        </div>
        <div class="vendor-preview-grid">
          {vendors.filter((vendor) => vendor.featured).map((vendor) => <VendorListing {vendor} compact />)}
        </div>
        <div class="vendor-preview-footer">
          <a class="button button-light" href="/vendors/">See the full vendor directory <Icon name="arrow" size={17} /></a>
          <a href="/partners/?interest=vendor#inquiry">Interested in vending?</a>
        </div>
      </div>
    </section>}

    {eventPhotos.length > 0 && (
      <section class="section event-gallery-section" aria-labelledby="event-gallery-title" data-event-gallery>
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">From the festival</p>
              <h2 id="event-gallery-title">Pearland shows up.</h2>
            </div>
            <p>A look at the families, businesses, and community that make the festival possible.</p>
          </div>
          <div class="event-gallery">
            {eventPhotos.map((photo) => (
              <figure>
                <img
                  src={photo.src}
                  alt={photo.alt}
                  width={photo.width}
                  height={photo.height}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="two-paths" aria-label="Festival information by audience">
      <div class="path-grid">
        <article class="path-panel">
          <p class="eyebrow">For families & friends</p>
          <h2>Make a night of it.</h2>
          <p>No tickets and no RSVP. Come for the candy, stay for the costume contest, music, shopping, and community.</p>
          <ul class="chip-list" aria-label="Family event highlights">
            <li>Free admission</li><li>Trick-or-treat</li><li>Costume contest</li><li>All ages</li>
          </ul>
          <a class="button button-light" href="#location" data-track-event="directions_cta_clicked" data-track-placement="audience_panel">Get directions <Icon name="arrow" size={17} /></a>
        </article>
        <article class="path-panel">
          <p class="eyebrow">For local businesses</p>
          <h2>Show up for Pearland.</h2>
          <p>Reach thousands of local families as a sponsor or vendor. Compare the published packages and contact the director from one dedicated page.</p>
          <ul class="chip-list" aria-label="Business opportunity highlights">
            <li>4,000+ past attendees</li><li>Sponsor packages</li><li>Vendor interest</li>
          </ul>
          <a class="button button-secondary" href="/partners/" data-track-event="partner_cta_clicked" data-track-placement="audience_panel">Business opportunities <Icon name="arrow" size={17} /></a>
        </article>
      </div>
    </section>

    <section class="section venue-section" id="location" aria-labelledby="location-title">
      <div class="container venue-grid">
        <div>
          <p class="eyebrow">Meet us in Pearland</p>
          <h2 class="display-heading" id="location-title">Right in the heart of town.</h2>
          <p>The festival takes over the Methodist Pavilion at Pearland Town Center. Trick-or-treating will take place at participating stores throughout the center.</p>
          <a class="button button-primary" href={event.mapsUrl} target="_blank" rel="noreferrer" data-track-event="directions_opened" data-track-placement="location_section">Open in maps <Icon name="arrow" size={17} /></a>
        </div>
        <div class="address-card">
          <iframe
            class="venue-map"
            src={event.mapEmbedUrl}
            title={`Google map showing ${event.venue}`}
            loading="lazy"
            allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
          <div class="address-card-copy">
            <strong>{event.venue}</strong>
            <span>{event.address}</span>
            <a href={event.mapsUrl} target="_blank" rel="noreferrer" data-track-event="directions_opened" data-track-placement="map_card">View directions <Icon name="arrow" size={16} /></a>
          </div>
        </div>
      </div>
    </section>

    <section class="impact-band" aria-labelledby="impact-title">
      <div class="container impact-inner">
        <div class="impact-copy">
          <span>Local businesses power this celebration</span>
          <h2 id="impact-title">Put your brand where the community gathers.</h2>
          <p>Sponsorships help create a safe, fun, and memorable experience for Pearland families.</p>
          <a class="button button-impact" href="/partners/" data-track-event="partner_cta_clicked" data-track-placement="impact_band">Explore sponsorships <Icon name="arrow" size={17} /></a>
        </div>
        <div class="impact-stat">4,000+<span>Attended last year</span></div>
      </div>
    </section>

    <SponsorWall />

    <section class="section" id="faq" aria-labelledby="faq-title">
      <div class="container narrow">
        <p class="eyebrow">Good to know</p>
        <h2 class="display-heading" id="faq-title">Festival FAQ</h2>
        <div class="faq-list">
          <details>
            <summary>Is the festival free?</summary>
            <p>Yes. Admission is free to the public and no RSVP is required.</p>
          </details>
          <details>
            <summary>When is the costume contest?</summary>
            <p>The costume contest is scheduled for 5:00–6:00 PM during the festival.</p>
          </details>
          <details>
            <summary>Where does trick-or-treating happen?</summary>
            <p>Participating stores at Pearland Town Center will be handing out candy. Look for festival signage when you arrive.</p>
          </details>
          <details>
            <summary>How can my business participate?</summary>
            <p>Visit the <a href="/partners/">business opportunities page</a> to compare sponsorship levels or submit a sponsor/vendor interest form.</p>
          </details>
          <details>
            <summary>Who can I contact with another question?</summary>
            <p>
              Email <a href={`mailto:${event.contactEmail}`}>{event.contactEmail}</a> or follow{" "}
              <a
                href={event.instagramUrl}
                target="_blank"
                rel="noreferrer"
                data-track-event="social_link_clicked"
                data-track-platform="instagram"
                data-track-placement="faq"
              >{event.socialHandle}</a>.
            </p>
          </details>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
