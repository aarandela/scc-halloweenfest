---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const onPartners = currentPath.startsWith("/partners");
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Space City Halloween Festival home">
      <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
        <path d="m20 1 4.3 13.6L39 20l-14.7 4.7L20 39l-4.6-14.3L1 20l14.4-5.4L20 1Z"></path>
        <circle cx="20" cy="20" r="4.5"></circle>
      </svg>
      <span><strong>Space City</strong><small>Halloween Festival</small></span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="/#event" aria-current={!onPartners ? "page" : undefined}>Event guide</a>
      <a href="/partners/" aria-current={onPartners ? "page" : undefined}>For businesses</a>
      <a href="/#faq">FAQ</a>
    </nav>

    <a class="button button-small header-cta" href={onPartners ? "#inquiry" : "/partners/"}>
      {onPartners ? "Send an inquiry" : "Partner with us"}
    </a>
  </div>
</header>
