---
import { event } from "../data/event";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand brand-artwork footer-brand" href="/" aria-label="Space City Halloween Festival home">
        <span class="brand-logo-crop">
          <img
            src="/space-city-collective-logo.jpg"
            alt="Space City Collective"
            width="438"
            height="438"
          />
        </span>
      </a>
      <p class="footer-note">A free community celebration presented by {event.organizer}.</p>
    </div>

    <div class="footer-links">
      <div>
        <p class="footer-label">Explore</p>
        <a href="/#event">Event details</a>
        <a href="/vendors/">Vendor lineup</a>
        <a href="/partners/">Business opportunities</a>
        <a href="/#faq">Frequently asked questions</a>
      </div>
      <div>
        <p class="footer-label">Connect</p>
        <a href={`mailto:${event.contactEmail}`}>{event.contactEmail}</a>
        <span>{event.socialHandle}</span>
        <span>Pearland, Texas</span>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© 2026 {event.organizer}</span>
    <span>Sponsors make this event possible for the kids.</span>
    <a class="footer-credit" href="https://arandela.co">Built by <strong>Arandela &amp; Co.</strong></a>
  </div>
</footer>
