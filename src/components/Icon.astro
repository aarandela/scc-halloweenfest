---
interface Props {
  name: "calendar" | "clock" | "pin" | "ticket" | "candy" | "trophy" | "spark" | "music" | "people" | "megaphone" | "growth" | "arrow";
  size?: number;
}

const { name, size = 24 } = Astro.props;
---

<svg class="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {name === "calendar" && <><path d="M5 3v3M19 3v3M3.5 9h17M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"/><path d="m8 14 2 2 5-5"/></>}
  {name === "clock" && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></>}
  {name === "pin" && <><path d="M20 10c0 5.5-8 11-8 11S4 15.5 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></>}
  {name === "ticket" && <><path d="M4 6h16v4a2 2 0 0 0 0 4v4H4v-4a2 2 0 0 0 0-4V6Z"/><path d="M12 8v2M12 14v2"/></>}
  {name === "candy" && <><path d="m7 9-4-2 1 4-1 4 4-2M17 9l4-2-1 4 1 4-4-2"/><rect x="7" y="7" width="10" height="8" rx="3"/></>}
  {name === "trophy" && <><path d="M8 4h8v4c0 4-2 6-4 6s-4-2-4-6V4ZM12 14v4M8 20h8"/><path d="M8 6H4v2c0 2 1 3 4 3M16 6h4v2c0 2-1 3-4 3"/></>}
  {name === "spark" && <><path d="m12 2 1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2Z"/><path d="m19 16 .7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7L19 16Z"/></>}
  {name === "music" && <><path d="M9 18V5l10-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="16" r="3"/></>}
  {name === "people" && <><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M15 14a5 5 0 0 1 6 5v1"/></>}
  {name === "megaphone" && <><path d="m4 13 13 5V4L4 9v4Z"/><path d="M4 9H2v4h2M7 14l1 5h3l-1-4"/></>}
  {name === "growth" && <><path d="M4 20V10M10 20V4M16 20v-7M22 20V7"/><path d="m3 8 6-5 6 7 7-6"/></>}
  {name === "arrow" && <><path d="M5 12h14M14 7l5 5-5 5"/></>}
</svg>
