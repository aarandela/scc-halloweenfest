---
import { event, sponsorTiers } from "../data/event";
import { vendorInquiryCategories } from "../data/vendors";

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const formConfigured = Boolean(web3formsAccessKey);
const turnstileConfigured = Boolean(turnstileSiteKey);
---

<div class="form-shell">
  <div class="form-heading">
    <p class="eyebrow">Start a conversation</p>
    <h2 id="inquiry-title">How would you like to take part?</h2>
    <p>Tell the festival team a little about your business. No payment or commitment is required.</p>
  </div>

  <form
    class="inquiry-form"
    action="https://api.web3forms.com/submit"
    method="post"
    data-inquiry-form
    data-configured={String(formConfigured)}
    data-requires-turnstile={String(turnstileConfigured)}
    data-contact-email={event.contactEmail}
    novalidate
  >
    <input type="hidden" name="access_key" value={web3formsAccessKey} />
    <input type="hidden" name="subject" value="New Space City Halloween Festival business inquiry" />
    <input type="hidden" name="from_name" value="Space City Halloween Festival Website" />
    <input type="hidden" name="campaign_source" value="" />
    <input type="hidden" name="campaign_medium" value="" />
    <input type="hidden" name="campaign_name" value="" />
    <input type="hidden" name="campaign_content" value="" />
    <input type="hidden" name="campaign_landing_page" value="" />

    <fieldset class="choice-fieldset">
      <legend>I’m interested in <span aria-hidden="true">*</span></legend>
      <div class="choice-grid">
        <label class="choice-card">
          <input type="radio" name="inquiryType" value="sponsor" checked />
          <span><strong>Sponsorship</strong><small>Brand visibility and community impact</small></span>
        </label>
        <label class="choice-card">
          <input type="radio" name="inquiryType" value="vendor" />
          <span><strong>Vending</strong><small>Sell or showcase at the festival</small></span>
        </label>
      </div>
      <span class="field-error" data-error-for="inquiryType"></span>
    </fieldset>

    <div class="form-grid">
      <label class="field">
        <span>Your name <b aria-hidden="true">*</b></span>
        <input name="contactName" autocomplete="name" aria-describedby="contactName-error" />
        <small class="field-error" id="contactName-error" data-error-for="contactName"></small>
      </label>
      <label class="field">
        <span>Business name <b aria-hidden="true">*</b></span>
        <input name="businessName" autocomplete="organization" aria-describedby="businessName-error" />
        <small class="field-error" id="businessName-error" data-error-for="businessName"></small>
      </label>
      <label class="field">
        <span>Email <b aria-hidden="true">*</b></span>
        <input type="email" name="email" autocomplete="email" inputmode="email" aria-describedby="email-error" />
        <small class="field-error" id="email-error" data-error-for="email"></small>
      </label>
      <label class="field">
        <span>Phone <em>Optional</em></span>
        <input type="tel" name="phone" autocomplete="tel" />
      </label>
      <label class="field field-wide">
        <span>Website or social profile <em>Optional</em></span>
        <input type="url" name="website" inputmode="url" placeholder="https://" />
      </label>
    </div>

    <div data-sponsor-fields>
      <label class="field">
        <span>Sponsorship level <b aria-hidden="true">*</b></span>
        <select name="sponsorTier" aria-describedby="sponsorTier-error">
          <option value="">Choose a level</option>
          <option value="not-sure">Not sure yet — help me choose</option>
          {sponsorTiers.map((tier) => <option value={tier.id}>{tier.name} — ${tier.price.toLocaleString()}</option>)}
        </select>
        <small class="field-error" id="sponsorTier-error" data-error-for="sponsorTier"></small>
      </label>
    </div>

    <div data-vendor-fields hidden>
      <label class="field">
        <span>What does your business offer? <b aria-hidden="true">*</b></span>
        <select name="vendorCategory" aria-describedby="vendorCategory-error">
          <option value="">Choose a category</option>
          {vendorInquiryCategories.map((category) => <option value={category}>{category}</option>)}
        </select>
        <small class="field-error" id="vendorCategory-error" data-error-for="vendorCategory"></small>
      </label>
      <div class="vendor-other-field" data-vendor-other-fields hidden>
        <label class="field">
          <span>Describe what your business offers <b aria-hidden="true">*</b></span>
          <input
            name="vendorOtherDescription"
            aria-describedby="vendorOtherDescription-error"
            placeholder="For example: pet adoption, photo booth, or kids activities"
          />
          <small
            class="field-error"
            id="vendorOtherDescription-error"
            data-error-for="vendorOtherDescription"
          ></small>
        </label>
      </div>
    </div>

    <label class="field">
      <span>Anything else we should know? <em>Optional</em></span>
      <textarea name="message" rows="4" placeholder="Questions, goals, space needs, or other details"></textarea>
    </label>

    <div class="honeypot" aria-hidden="true">
      <label>Company website <input name="company" tabindex="-1" autocomplete="off" /></label>
      <label>Leave this field empty <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label>
    </div>

    <label class="consent">
      <input type="checkbox" name="consent" />
      <span>
        I agree that Space City Collective may contact me about this inquiry. See our{" "}
        <a href="/privacy/" target="_blank">Privacy Policy</a>. <b aria-hidden="true">*</b>
      </span>
    </label>
    <small class="field-error" data-error-for="consent"></small>

    {turnstileConfigured && (
      <div class="turnstile-shell">
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>
      </div>
    )}

    <div class="form-footer">
      <button class="button button-primary" type="submit">Send interest form</button>
      <p>Prefer email? <a href={`mailto:${event.contactEmail}`}>{event.contactEmail}</a></p>
    </div>
    {!formConfigured && (
      <p class="form-note">Form delivery needs its Web3Forms access key. Until it is configured, please email the festival team directly.</p>
    )}
    <p class="form-status" data-form-status role="status" aria-live="polite"></p>
  </form>
</div>

{turnstileConfigured && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  import { prepareInquiry, validateInquiry, type InquiryInput } from "../lib/inquiry";

  const form = document.querySelector<HTMLFormElement>("[data-inquiry-form]");

  if (form) {
    const sponsorFields = form.querySelector<HTMLElement>("[data-sponsor-fields]");
    const vendorFields = form.querySelector<HTMLElement>("[data-vendor-fields]");
    const vendorOtherFields = form.querySelector<HTMLElement>("[data-vendor-other-fields]");
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    const getInput = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;

    const getInquiryType = () => {
      const selected = form.querySelector<HTMLInputElement>('input[name="inquiryType"]:checked');
      return selected?.value === "vendor" ? "vendor" : "sponsor";
    };

    if (new URLSearchParams(window.location.search).get("interest") === "vendor") {
      const vendorChoice = form.querySelector<HTMLInputElement>('input[name="inquiryType"][value="vendor"]');
      if (vendorChoice) vendorChoice.checked = true;
    }

    const updateConditionalFields = () => {
      const isSponsor = getInquiryType() === "sponsor";
      const isOtherVendor = !isSponsor && getInput("vendorCategory")?.value === "Other";
      if (sponsorFields) sponsorFields.hidden = !isSponsor;
      if (vendorFields) vendorFields.hidden = isSponsor;
      if (vendorOtherFields) vendorOtherFields.hidden = !isOtherVendor;
      sponsorFields?.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select").forEach((control) => {
        control.disabled = !isSponsor;
      });
      vendorFields?.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select").forEach((control) => {
        control.disabled = isSponsor;
      });
      const vendorOtherInput = getInput("vendorOtherDescription");
      if (vendorOtherInput) vendorOtherInput.disabled = !isOtherVendor;
      getInput("sponsorTier")?.toggleAttribute("aria-required", isSponsor);
      getInput("vendorCategory")?.toggleAttribute("aria-required", !isSponsor);
      getInput("vendorOtherDescription")?.toggleAttribute("aria-required", isOtherVendor);
      if (!isOtherVendor && getInput("vendorOtherDescription")) {
        getInput("vendorOtherDescription")!.value = "";
      }
    };

    const readInput = (): InquiryInput => ({
      inquiryType: getInquiryType(),
      contactName: getInput("contactName")?.value ?? "",
      businessName: getInput("businessName")?.value ?? "",
      email: getInput("email")?.value ?? "",
      phone: getInput("phone")?.value ?? "",
      website: getInput("website")?.value ?? "",
      sponsorTier: getInput("sponsorTier")?.value ?? "",
      vendorCategory: getInput("vendorCategory")?.value ?? "",
      vendorOtherDescription: getInput("vendorOtherDescription")?.value ?? "",
      message: getInput("message")?.value ?? "",
      consent: (getInput("consent") as HTMLInputElement | null)?.checked ?? false,
      company: getInput("company")?.value ?? ""
    });

    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>("[data-error-for]").forEach((element) => {
        element.textContent = "";
      });
      form.querySelectorAll<HTMLElement>("[aria-invalid]").forEach((element) => {
        element.removeAttribute("aria-invalid");
      });
      if (status) status.textContent = "";
    };

    const showErrors = (errors: ReturnType<typeof validateInquiry>) => {
      for (const [name, message] of Object.entries(errors)) {
        const error = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
        if (error) error.textContent = message;
        const input = getInput(name);
        input?.setAttribute("aria-invalid", "true");
      }
      const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
      firstInvalid?.focus();
      if (status) status.textContent = errors.form ?? "Please check the highlighted fields.";
    };

    form.addEventListener("change", (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name === "inquiryType" || target.name === "vendorCategory") {
        updateConditionalFields();
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearErrors();

      const input = readInput();
      const errors = validateInquiry(input);
      if (Object.keys(errors).length) {
        showErrors(errors);
        return;
      }

      const accessKey = getInput("access_key")?.value.trim();
      if (form.dataset.configured !== "true" || !accessKey) {
        if (status) {
          status.textContent = `This form is not available yet. Please email ${form.dataset.contactEmail ?? "the festival team"} instead.`;
        }
        return;
      }

      if (form.dataset.requiresTurnstile === "true") {
        const turnstileResponse = getInput("cf-turnstile-response")?.value.trim();
        if (!turnstileResponse) {
          if (status) status.textContent = "Please complete the verification before sending your inquiry.";
          return;
        }
      }

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = "Sending…";
      }

      try {
        const prepared = prepareInquiry(input);
        const payload = new FormData(form);
        for (const [name, value] of Object.entries(prepared)) {
          payload.set(name, String(value));
        }

        if (input.inquiryType === "sponsor") {
          payload.delete("vendorCategory");
          payload.delete("vendorOtherDescription");
        } else {
          payload.delete("sponsorTier");
          if (input.vendorCategory !== "Other") payload.delete("vendorOtherDescription");
        }

        for (const name of [
          "campaign_source",
          "campaign_medium",
          "campaign_name",
          "campaign_content",
          "campaign_landing_page"
        ]) {
          if (!String(payload.get(name) ?? "").trim()) payload.delete(name);
        }

        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: payload
        });
        const result = await response.json().catch(() => null) as { success?: boolean } | null;
        if (!response.ok || !result?.success) throw new Error(`Web3Forms returned ${response.status}`);

        const conversionProperties: Record<string, string> = {
          inquiry_type: input.inquiryType
        };
        if (input.inquiryType === "sponsor") conversionProperties.sponsor_tier = input.sponsorTier;
        if (input.inquiryType === "vendor") conversionProperties.vendor_category = input.vendorCategory;

        await Promise.race([
          window.sccAnalytics?.track("inquiry_submitted", conversionProperties) ?? Promise.resolve(),
          new Promise((resolve) => window.setTimeout(resolve, 500))
        ]);
        window.location.assign("/partners/thanks/");
      } catch {
        (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();
        if (status) status.textContent = "We couldn’t send your inquiry. Please try again or email the festival team directly.";
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = "Send interest form";
        }
      }
    });

    updateConditionalFields();
  }
</script>
