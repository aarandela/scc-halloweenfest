---
import { event } from "../data/event";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand footer-brand" href="/" aria-label="Space City Halloween Festival home">
        <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
          <path d="m20 1 4.3 13.6L39 20l-14.7 4.7L20 39l-4.6-14.3L1 20l14.4-5.4L20 1Z"></path>
          <circle cx="20" cy="20" r="4.5"></circle>
        </svg>
        <span><strong>Space City</strong><small>Halloween Festival</small></span>
      </a>
      <p class="footer-note">A free community celebration presented by {event.organizer}.</p>
    </div>

    <div class="footer-links">
      <div>
        <p class="footer-label">Explore</p>
        <a href="/#event">Event details</a>
        <a href="/partners/">Business opportunities</a>
        <a href="/#faq">Frequently asked questions</a>
      </div>
      <div>
        <p class="footer-label">Connect</p>
        <a href={`mailto:${event.contactEmail}`}>{event.contactEmail}</a>
        <span>{event.socialHandle}</span>
        <span>Pearland, Texas</span>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© 2026 {event.organizer}</span>
    <span>Sponsors make this event possible for the kids.</span>
  </div>
</footer>
